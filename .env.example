# Set these values in the production environment before launch.
PUBLIC_SITE_URL=https://your-real-domain.example
ALLOWED_ORIGINS=https://your-real-domain.example
# Optional exact IP addresses for reverse proxies that set X-Forwarded-For.
# Forwarded client IPs are ignored unless the immediate socket peer is listed.
TRUSTED_PROXY_IPS=
ADMIN_PASSWORD_HASH= # Generate using: node scripts/generate-admin-credentials.mjs
ADMIN_TOTP_SECRET= # Generated by the same helper; add it to your authenticator
WEBHOOK_SECRET= # Set only when a webhook provider is configured
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
